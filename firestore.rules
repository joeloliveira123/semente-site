rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Configurações gerais (status de transmissão ao vivo e banners)
    match /config/{configId} {
      allow read, write: if true;
    }

    // Coleção de eventos especiais e avisos da igreja
    match /events/{eventId} {
      allow read, write: if true;
    }

    // Coleção de pedidos de oração enviados pelo site e geridos no painel
    match /prayer_requests/{requestId} {
      allow read, write: if true;
    }
  }
}
