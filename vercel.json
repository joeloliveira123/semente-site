{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/admin", "destination": "/painel.html" },
    { "source": "/painel", "destination": "/painel.html" },
    { "source": "/missoes", "destination": "/missoes.html" },
    { "source": "/cantata", "destination": "/cantata.html" },
    { "source": "/convite", "destination": "/convite.html" },
    { "source": "/convite-missoes", "destination": "/convite.html" }
  ],
  "headers": [
    {
      "source": "/assets/culto-de-missoes.ics",
      "headers": [
        { "key": "Content-Type", "value": "text/calendar; charset=utf-8" },
        { "key": "Content-Disposition", "value": "inline; filename=\"culto-de-missoes.ics\"" }
      ]
    }
  ]
}
